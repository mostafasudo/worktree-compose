{
  "name": "worktree-compose",
  "version": "1.1.0",
  "description": "Zero-config Docker Compose isolation for git worktrees",
  "type": "module",
  "bin": {
    "worktree-compose": "dist/cli.js",
    "wtc": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "wtc.schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "worktree",
    "docker",
    "compose",
    "isolation",
    "parallel",
    "development",
    "mcp",
    "podman"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostafasudo/worktree-compose.git"
  },
  "bugs": {
    "url": "https://github.com/mostafasudo/worktree-compose/issues"
  },
  "homepage": "https://www.worktree-compose.com",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
